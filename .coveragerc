[run]
source = epanetparser
omit =
    epanetparser/core/io/epanet/*
    epanetparser/core/io/network/*
    epanetparser/core/parse.py
    epanetparser/core/mcp_server.py
    epanetparser/core/display.py
    epanetparser/core/plugins_cli.py
    epanetparser/core/download.py
    epanetparser/core_rules/core_static/epanet_core/*

[report]
fail_under = 70
show_missing = true
precision = 2