@startuml epanetparser_class_hierarchy

' =====================================================================
' epanetparser -- class hierarchy overview
'
' Accurate as of the three-layer validation refactor. Validation is a
' separate stage from parsing, and rules are plain functions rather than
' methods on the component classes, so nothing here validates on data
' assignment. Three layers -- structural, static and simulation -- feed
' one ValidationReport.
'
' Detail diagrams:
'   epanetparser_model_layer.puml        components and the network
'   epanetparser_validation_engine.puml  registry, validator, results
'   epanetparser_rule_sets.puml          rule set modules and exceptions
' =====================================================================

title EPANET Parser - Class Hierarchy Overview
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 45
skinparam shadowing false
hide empty members

legend right
  |<#lightblue> Parser / INP reader |
  |<#wheat> Structural layer |
  |<#lightgreen> Model base |
  |<#lightyellow> Component collections |
  |<#lavender> Validation engine |
  |<#lightcyan> Simulation layer |
  |<#pink> Rule sets |
  |<#lightgray> Expanded in a detail diagram |
endlegend

' ---------------------------------------------------------------------
' STAGE 1: PARSER
' ---------------------------------------------------------------------
class WNTRJSONParser #lightblue {
  + __init__(json_src: str)
  --
  + parse() -> WNTREPANETNetwork
  + enforce_unique(ordered_pairs)
  + missing_keys() -> List[str]
  + has_errors() -> bool
  + has_warnings() -> bool
  --
  Builds a model and nothing else.
  Reports structural problems only.
  Takes no rule set argument.
}

' ---------------------------------------------------------------------
' STAGE 1b: STRUCTURAL LAYER
'
' Structural failures are raised while a document is read, before any
' network exists. They are the first of the three validation layers.
' ---------------------------------------------------------------------
class InpParseError #wheat {
  + message / line_number
  + section / error_code
  + suggestions
  --
  + to_dict() -> dict
  + to_validation_issue() -> ValidationIssue
  --
  Base of structural parser failures.
  to_validation_issue() presents one as
  an issue with validation_layer
  "structural" and code E_PARSE_FAILED.
}

class InpSyntaxError #wheat {
  + error_code defaults to "201"
  --
  Malformed section headers, wrong
  field counts or invalid values
  (codes 201, 202, 213).
}

class InpSemanticError #wheat {
  + error_code defaults to "203"
  --
  Valid syntax but unresolved
  references or invalid values
  (codes 203, 205, 209, 211, 217,
  225).
}

class InpStructuralError #wheat {
  + error_code defaults to "204"
  --
  Missing required sections or
  fundamental file problems
  (codes 200, 204).
}

class "EPANET_ERROR_MAP\ncreate_inp_error()" as InpErrorFactory #wheat {
  Maps an EPANET error code to the
  matching InpParseError subclass and
  instantiates it.
}

class read_inp_to_dict <<function>> #lightblue {
  read_inp_to_dict(filepath) -> dict
  --
  Standalone INP reader (vendored
  WNTR core.io). An InpParseError it
  raises reaches from_file() as a
  structural issue.
}

' ---------------------------------------------------------------------
' STAGE 2: MODEL
' ---------------------------------------------------------------------
abstract class WNTREPANETType <<ABC>> #lightgreen {
  + data: Dict[str, Any]
  + component_kind: Optional[str]
  --
  + {abstract} type: str
  + validate(context) -> ValidationReport
  + as_dict() -> Dict[str, Any]
  + as_json() -> str
  --
  Base class for every component.
  Holds a data dict and read-only accessors.
  Contains no rules and cannot be extended
  to add them.
}

class WNTREPANETNetwork #lightgreen {
  + from_file(filename, ...) -> Tuple
  + from_json(json_src, ...) -> Tuple
  --
  + build_index() -> NetworkIndex
  + invalidate_index() -> None
  + validate(context) -> ValidationReport
  + report() -> Dict[str, int]
  + verbose_report() -> Dict[str, int]
  + component(collection, name)
  + name / comment / version
}

class "WNTREPANETNode\nWNTREPANETLink\nWNTREPANETCurve\nWNTREPANETPattern\nWNTREPANETControl\nWNTREPANETSource\nWNTREPANETOptions\nWNTREPANETNetworkInfo" as Components #lightyellow {
  8 concrete component classes
  --
  Each wraps one data dict and exposes
  typed read-only accessors.
}

class NetworkIndex #lightgray {
  9 accessors
  --
  name -> component resolution,
  built lazily by build_index()
  and cached on the network.
}

' ---------------------------------------------------------------------
' STAGE 3: VALIDATION ENGINE
' ---------------------------------------------------------------------
class Validator #lavender {
  + from_context(context) -> Validator
  + rules_for(component)
  + simulation_rules()
  --
  + validate(network, context)
  + validate_component(component, rules)
  + validate_network(network, rules)
  + validate_simulation(results, report)
  --
  Runs the selected rules. Returns a
  report; never raises for a rule failure.
  validate_simulation() runs the
  simulation layer against WNTR results.
}

class RuleSetRegistry #lavender {
  + discover(refresh) -> Dict[str, RuleSet]
  + resolve(selection) -> Validator
  + get(key) / keys() / all()
  + core_keys() / custom_keys()
  + describe(key)
}

class RuleSet <<frozen>> #lavender {
  + key / name / version
  + description / is_core / module_path
  --
  + component_rules: Tuple[RuleSpec, ...]
  + network_rules: Tuple[RuleSpec, ...]
  + simulation_rules: Tuple[SimulationRuleSpec, ...]
  --
  Rules collected once at construction,
  so selecting a rule set repeatedly is
  cheap.
}

class RuleSpec <<frozen>> #lavender {
  + rule_id / func
  + component_type / severity
  + code / attribute
  + description / is_network
  --
  A rule function plus the metadata
  used to report its failures.
}

class ValidationReport #lavender {
  + is_valid: bool
  + errors / warnings / info
  --
  + by_code(code) / by_component(name)
  + by_rule(rule_id) / by_severity(sev)
  + codes() / grouped_by_component()
  + as_dict()
}

class ValidationIssue <<frozen>> #lavender {
  + code / message / severity
  + rule_id / ruleset_key
  + component_type / component_name
  + attribute / component_data
  + context / category
  + fix_suggestion
  + validation_layer
  + simulation_metadata
  --
  One finding. validation_layer is one
  of "structural", "static" or
  "simulation". The code is stable, so
  downstream tooling matches on it rather
  than on message text.
}

class Severity <<enumeration>> #lavender {
  ERROR
  WARNING
  INFO
}

class ValidationContext #lavender {
  + ruleset_keys() -> Tuple[str, ...]
  + from_any(selection) -> ValidationContext
  --
  Rule set selection. Accepts a key, a
  sequence of keys, a context, or a
  mapping with core and custom entries.
}

' ---------------------------------------------------------------------
' STAGE 4: RULE SETS
' ---------------------------------------------------------------------
class epanet_core <<module>> #pink {
  __key__ = "epanet_core"
  __is_core__ = True
  __version__ = "1.0.0"
  --
  119 component rules
  33 network rules
  --
  Simulator-agnostic: required fields,
  valid types, well-formed curves, unique
  names, resolvable references.
}

class milp <<module>> #pink {
  __key__ = "milp"
  __is_core__ = False
  __version__ = "0.2.0"
  --
  17 component rules
  --
  Constraints of one application: fixed
  horizon, timestep, pattern count,
  demand model, no check valves.
}

class hydraulic <<module>> #pink {
  __key__ = "hydraulic"
  __is_core__ = False
  __version__ = "1.0.0"
  --
  7 simulation rules
  --
  Post-simulation checks over WNTR
  results: pressure, velocity,
  headloss, flow continuity and energy.
}

' ---------------------------------------------------------------------
' STAGE 5: SIMULATION LAYER
'
' Runs after a hydraulic simulation, on the results object rather than
' the model. The last of the three validation layers.
' ---------------------------------------------------------------------
class SimulationRuleSpec <<frozen>> #lightcyan {
  + rule_id / func / severity
  + code / attribute / description
  + category / fix_suggestion
  + required_outputs / context
  --
  + is_error / is_warning
  + issue_context() -> Dict
  --
  A rule over simulation results. The
  engine skips it when the simulator
  did not produce its required_outputs.
}

class simulation_rule <<decorator>> #lightcyan {
  + severity / code / attribute
  + required_outputs
  --
  Declares a simulation rule and
  attaches a SimulationRuleSpec under
  __epanetparser_simulation_rule__.
}

' ---------------------------------------------------------------------
' RELATIONSHIPS
' ---------------------------------------------------------------------
WNTRJSONParser ..> Components : creates
WNTRJSONParser ..> WNTREPANETNetwork : builds

read_inp_to_dict ..> InpParseError : raises
InpErrorFactory ..> InpParseError : builds
InpParseError <|-- InpSyntaxError : (201, 202, 213)
InpParseError <|-- InpSemanticError : (203, 205, 209, ...)
InpParseError <|-- InpStructuralError : (200, 204)
InpParseError ..> ValidationIssue : to_validation_issue()

WNTREPANETType <|-- Components : (8 subclasses)

WNTREPANETNetwork o-- Components : owns
WNTREPANETNetwork *-- NetworkIndex : caches

WNTREPANETType ..> Validator : validate()
WNTREPANETNetwork ..> Validator : validate()

Validator ..> RuleSpec : runs
Validator ..> ValidationReport : returns
Validator ..> ValidationContext : selection

RuleSetRegistry ..> RuleSet : discovers
RuleSetRegistry ..> ValidationContext : resolves

RuleSet *-- RuleSpec : collects
RuleSet *-- SimulationRuleSpec : collects
RuleSpec ..> Severity : severity

Validator ..> SimulationRuleSpec : validate_simulation()
simulation_rule ..> SimulationRuleSpec : attaches
hydraulic ..> SimulationRuleSpec : defines
SimulationRuleSpec ..> Severity : severity

ValidationReport o-- ValidationIssue : aggregates
ValidationIssue ..> Severity : severity

epanet_core ..> RuleSet : defines
milp ..> RuleSet : defines
hydraulic ..> RuleSet : defines

note as Flow
  **Three validation layers, one report.**
  ..
  1. Structural: while the document is
     read, an InpParseError is raised
     and surfaces as a layer
     "structural" issue.
  2. The parser builds components.
     Assigning .data never validates
     and never raises.
  3. Static: component.validate()
     delegates to the engine, which
     runs the selected RuleSpecs.
  4. Simulation: validate_simulation()
     runs SimulationRuleSpecs over
     WNTR results, skipping rules whose
     required_outputs are absent.
  5. AssertionError becomes a
     ValidationIssue on a
     ValidationReport.
  6. Only Severity.ERROR makes a report
     invalid.
end note

WNTREPANETType .. Flow
Validator .. Flow

@enduml
